@using NetBlaze.SharedKernel.SharedResources

<EditForm Model="_updateDepartmentRequestDto" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <MudDialog>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_updateDepartmentRequestDto.Name"
                                  Label="@Messages.DepartmentName"
                                  Variant="Variant.Outlined"
                                  Immediate
                                  Required
                                  AutoFocus="false"
                                  Class="mb-3" />
                </MudItem>
            </MudGrid>
        </DialogContent>

        <DialogActions>
            <MudButton OnClick="Cancel">
                @Messages.Cancel
            </MudButton>

            <MudButton ButtonType="ButtonType.Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled">
                @Messages.EditDepartment
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>
