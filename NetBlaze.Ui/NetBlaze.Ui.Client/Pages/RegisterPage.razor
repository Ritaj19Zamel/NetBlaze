@page "/register"
@using Microsoft.AspNetCore.Authorization
@using NetBlaze.SharedKernel.HelperUtilities.General

@if (!_isPageReady)
{
    <MudContainer Class="d-flex align-center justify-center" Style="min-height:100vh">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" />
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <MudPaper Elevation="3" Class="pa-8" Style="border-radius: 16px;">

            <div class="d-flex justify-space-between align-center mb-6">
                <MudText Typo="Typo.h4" Class="font-weight-bold">Add New User</MudText>
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="/users">
                    Back to Users
                </MudButton>
            </div>

            <MudForm @ref="_form" Model="_registerRequestDto">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_registerRequestDto.DisplayName"
                                      Label="Full Name"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      FullWidth="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_registerRequestDto.Email"
                                      Label="Email"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      FullWidth="true"
                                      InputType="InputType.Email" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_registerRequestDto.PhoneNumber"
                                      Label="Phone Number"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      FullWidth="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect @bind-Value="_registerRequestDto.DepartmentId"
                                   T="long"
                                   Label="Department"
                                   Variant="Variant.Outlined"
                                   ToStringFunc="@GetDepartmentName"
                                   Required="true"
                                   FullWidth="true">
                            @foreach (var dept in _departments)
                            {
                                <MudSelectItem T="long" Value="dept.Id">
                                    @dept.Name
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect @bind-Value="_registerRequestDto.RoleId"
                                   T="long"
                                   Label="Role"
                                   Variant="Variant.Outlined"
                                   ToStringFunc="@GetRoleName"
                                   Required="true"
                                   FullWidth="true">
                            @foreach (var role in _roles)
                            {
                                <MudSelectItem T="long" Value="role.Id">
                                    @role.RoleName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect @bind-Value="_registerRequestDto.ManagerId"
                                   T="long?"
                                   Label="Manager (Optional)"
                                   Variant="Variant.Outlined"
                                   FullWidth="true"
                                   ToStringFunc="@GetManagerName"
                                   Clearable="true">
                            @foreach (var manager in _managers)
                            {
                                <MudSelectItem T="long?" Value="manager.Id">
                                    @manager.Name
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.h6" Class="mb-4">Password Setup</MudText>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_registerRequestDto.Password"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showPassword? InputType.Text: InputType.Password)"
                                      Required="true"
                                      FullWidth="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      AdornmentAriaLabel="Toggle password visibility"
                                      OnAdornmentClick="TogglePassword" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_registerRequestDto.ConfirmPassword"
                                      Label="Confirm Password"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showConfirmPassword? InputType.Text: InputType.Password)"
                                      Required="true"
                                      FullWidth="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showConfirmPassword? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      AdornmentAriaLabel="Toggle confirm password visibility"
                                      OnAdornmentClick="ToggleConfirmPassword" />
                    </MudItem>

                    <MudItem xs="12" Class="mt-6">
                        <div class="d-flex gap-4">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       Disabled="@_isSubmitting"
                                       OnClick="OnRegisterAsync"
                                       StartIcon="@Icons.Material.Filled.PersonAdd">
                                @if (_isSubmitting)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate Class="mr-2" />
                                    <span>Adding User...</span>
                                }
                                else
                                {
                                    <span>Add User</span>
                                }
                            </MudButton>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Size="Size.Large"
                                       Disabled="@_isSubmitting"
                                       OnClick="ResetForm">
                                Reset
                            </MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudForm>

        </MudPaper>
    </MudContainer>
}