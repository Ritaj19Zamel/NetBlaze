@page "/verify-otp"


<PageTitle>@Messages.VerifyOtp</PageTitle>

<MudPaper Class="pa-6 mx-auto" Style="max-width:420px">

    <MudText Typo="Typo.h6" Class="mb-4 text-center">
        @Messages.EnterOtp
    </MudText>

    <MudTextField Label="@Messages.OtpCode"
                  @bind-Value="_otp"
                  Required
                  Immediate />

    <MudButton FullWidth
               Color="Color.Primary"
               Variant="Variant.Filled"
               Class="mt-4"
               OnClick="VerifyOtpAsync">
        @Messages.Verify
    </MudButton>

</MudPaper>
