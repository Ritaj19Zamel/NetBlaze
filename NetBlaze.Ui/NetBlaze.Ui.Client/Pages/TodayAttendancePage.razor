@page "/today-attendance"
@using Microsoft.AspNetCore.Authorization
@using NetBlaze.SharedKernel.Enums
@using NetBlaze.SharedKernel.HelperUtilities.General

<PageTitle>@Messages.TodayAttendance</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small"
              Class="d-flex align-center justify-center"
              Style="min-height: calc(100vh - 64px);">

    <MudCard Style="width:100%">

        <MudCardHeader Class="d-flex justify-center">
            <MudText Typo="Typo.h6">
                @Messages.TodayAttendance
            </MudText>
        </MudCardHeader>

        <MudCardContent Class="text-center">

            @if (_isLoading)
            {
                <MudProgressCircular Indeterminate />
            }
            else
            {
                <MudStack Spacing="2" AlignItems="AlignItems.Center">

                    <MudText>
                        <b>@Messages.Date:</b> @DateTime.Today.ToString("yyyy-MM-dd")
                    </MudText>

                    <MudChip T="string" Color="@StatusColor">
                        @EnumLocalizationHelper.LocalizeEnum(_status, Localizer)
                    </MudChip>

                    <MudDivider Class="w-100" />

                    <MudText>
                        <b>@Messages.CheckIn:</b> @_lastCheckInText
                    </MudText>

                    <MudText>
                        <b>@Messages.CheckOut:</b> @_lastCheckOutText
                    </MudText>

                </MudStack>
            }

        </MudCardContent>

        <MudCardActions Class="d-flex justify-center pb-4">

            @if (_status == TodayAttendanceStatus.NotCheckedIn)
            {
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="_isProcessing"
                           OnClick="RecordAttendance">
                    @Messages.CheckIn
                </MudButton>
            }
            else if (_status == TodayAttendanceStatus.CheckedIn)
            {
                <MudButton Color="Color.Warning"
                           Variant="Variant.Filled"
                           Disabled="_isProcessing"
                           OnClick="RecordAttendance">
                    @Messages.CheckOut
                </MudButton>
            }
            else
            {
                <MudText Color="Color.Success">
                    @Messages.AttendanceCompleted
                </MudText>
            }

        </MudCardActions>

    </MudCard>

</MudContainer>
